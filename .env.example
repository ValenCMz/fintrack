# Postgres
POSTGRES_DB=fintrackdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Backend
JWT_SECRET=generate-with-openssl-rand-hex-64
JWT_EXPIRATION=3600000
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tucuenta@gmail.com
MAIL_PASSWORD=tu-app-password

# Puertos (host -> contenedor). El frontend escucha en 3000 adentro; acá mapeás el de tu Mac.
FRONTEND_PORT=3000
BACKEND_PORT=8080

# URLs (FRONTEND_URL y CORS_ALLOWED_ORIGINS deben coincidir con FRONTEND_PORT)
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000